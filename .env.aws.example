# AWS Backend Configuration
# Copy this file to .env and fill in your AWS credentials
# These values are output by CDK deployment (npx cdk deploy)

VITE_BACKEND=aws

# AWS Region
VITE_AWS_REGION=us-east-1

# Cognito Configuration (from CDK outputs)
VITE_AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_AWS_USER_POOL_CLIENT_ID=your-client-id
VITE_AWS_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API Gateway Endpoint (from CDK outputs)
VITE_AWS_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Google Drive Integration (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_API_KEY=your-google-api-key
