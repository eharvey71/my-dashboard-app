# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed vars, and
# everything here ships in the browser bundle - so nothing secret belongs in
# this file. Secrets live in Cloud Functions (firebase functions:secrets:set).

# TinyMCE editor key. Public by necessity - restrict it by domain in the
# TinyMCE console; that domain lock, not secrecy, is the protection.
VITE_TINYMCE_API_KEY=

# Google Drive import. The client ID is public. VITE_GOOGLE_API_KEY is optional
# and must be a browser API key restricted by HTTP referrer - never an OAuth
# client secret (GOCSPX-...).
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Weather widget (already read from env by WeatherWidget.jsx)
VITE_WEATHER_API_KEY=
